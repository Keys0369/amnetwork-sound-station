{
  "$schema": "https://json.schemastore.org/tsconfig.json",
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "resolveJsonModule": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "composite": true,
    "baseUrl": ".",
    "paths": {
      "@amnetwork/types": ["./packages/types/src"],
      "@amnetwork/audio-engine": ["./packages/audio-engine/src"],
      "@amnetwork/mixer": ["./packages/mixer/src"],
      "@amnetwork/ui": ["./packages/ui/src"],
      "@amnetwork/storage": ["./packages/storage/src"],
      "@amnetwork/shared": ["./packages/shared/src"],
      "@amnetwork/ai": ["./packages/ai/src"],
      "@amnetwork/auth": ["./packages/auth/src"],
      "@amnetwork/cloud": ["./packages/cloud/src"],
      "@amnetwork/frequencies": ["./packages/frequencies/src"],
      "@amnetwork/presets": ["./packages/presets/src"]
    }
  },
  "include": ["src"],
  "exclude": ["node_modules", "dist", "build", ".next", "coverage"]
}
