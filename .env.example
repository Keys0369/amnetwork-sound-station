# Audio Engine
VITE_AUDIO_CONTEXT_SAMPLE_RATE=44100
VITE_AUDIO_BUFFER_SIZE=4096

# Storage
VITE_STORAGE_TYPE=indexeddb
VITE_STORAGE_ENCRYPTION_ENABLED=true

# API
VITE_API_BASE_URL=http://localhost:3000
VITE_API_TIMEOUT=30000

# Cloud Features (Future)
VITE_CLOUD_ENABLED=false
VITE_CLOUD_API_URL=https://api.amnetwork.ai

# AI Features (Future)
VITE_AI_ENABLED=false
VITE_AI_PROVIDER=openai

# Analytics
VITE_ANALYTICS_ENABLED=false
VITE_ANALYTICS_ID=

# Environment
NODE_ENV=development
