{
  "name": "@amnetwork/presets",
  "version": "0.1.0",
  "description": "Curated sound presets and mixer configurations",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts",
    "clean": "rm -rf dist",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@amnetwork/types": "workspace:*"
  },
  "devDependencies": {
    "typescript": "^5.3.3",
    "tsup": "^8.0.0"
  }
}
